# All optional. With no keys, Cortex runs fully offline on its deterministic path.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# CORTEX_EMBEDDER=st                      # use sentence-transformers instead of offline LSA
# OTEL_EXPORTER_OTLP_ENDPOINT=https://... # mirror traces to Langfuse / Grafana / Jaeger
CORTEX_CONFORMAL_ALPHA=0.1
CORTEX_CONTEXT_BUDGET=3000
