# Copy to .env (never commit .env). Any one key turns on the live-LLM path; with none, Cortex
# runs its deterministic offline path. Pick a CURRENT free model id from https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional second / third provider: with two or more, the bandit router has a real choice to learn.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Free tiers are rate limited: space calls out (seconds between calls to one provider).
CORTEX_MIN_CALL_INTERVAL=3.5

# Finance domain: SEC fair-access policy requires a contact.
SEC_USER_AGENT=

# CORTEX_EMBEDDER=st                      # sentence-transformers instead of offline LSA
# OTEL_EXPORTER_OTLP_ENDPOINT=https://... # mirror traces to Langfuse / Grafana / Jaeger
